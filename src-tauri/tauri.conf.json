{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AYMAN MACRO DECK",
  "version": "0.1.1",
  "identifier": "com.ayman.macrodeck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AYMAN MACRO DECK",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNDBGRTg4REEwMDhDNTUKUldSVmpBRGFpUDVBWDFzRWVlL0FtblZWbFo4VHQ3TGEyZWJRdi9EQWwrbW1uaUQ1ZW93YWRkY2IK",
      "endpoints": [
        "https://github.com/aymansomo/ayman-macro-deck/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
